<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_custom_index_file_option" model="ir.ui.view">
        <field name="name">res.config.settings.view.custom.index.file.option</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@id='companies']" position="inside">
                <div class="app_settings_block" string="Vendor Marketplace">
                    <h2>Custom Index File</h2>

                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="index_file"/>
                                <div class="text-muted">
                                    Index File
                                </div>
                                <field name="index_file"/>
                            </div>
                        </div>
                    </div>

                </div>
            </xpath>

        </field>
    </record>

</odoo>
